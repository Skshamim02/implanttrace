# Copy to .env and fill in. Never commit .env.

# development | production   (production refuses to start with unsafe settings)
ENVIRONMENT=development

# Local runs default to SQLite. docker-compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./implanttrace.db
POSTGRES_PASSWORD=change-me

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-dev-only-change-me
# true when served over HTTPS (required in production)
COOKIE_SECURE=false
SESSION_HOURS=9

# Inspection import
INBOX_DIR=inbox
MAX_UPLOAD_MB=5

# Quality alerts when orders go on hold (optional; otherwise they are only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=implanttrace@example.com
QUALITY_ALERT_EMAILS=
TEAMS_WEBHOOK_URL=

# text | json
LOG_FORMAT=text
LOG_LEVEL=INFO
